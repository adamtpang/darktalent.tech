// ──────────────────────────────────────────────────────────────────────────
//  darktalent.tech, the data model
//
//  Design principles:
//   • Provenance: every signal traces back to a source plus a snapshot in time.
//   • Explainability: full score breakdowns are stored, not just a number.
//   • Consent-first: ingestion, display, and contact are gated by ConsentRecord
//     (GDPR lawful basis and right-to-erasure are first-class, not bolted on).
//   • Fast ranking: the latest score is denormalized onto TalentProfile so the
//     directory can sort and filter millions of rows without a join.
//
//  THE CARD. TalentProfile is the shared object of the talent trifecta named in
//  ECOSYSTEM.md. Its scores come from darktalent (Score, SignalSnapshot), its
//  artifacts come from company.university (Artifact), and it is transacted by
//  skill.supply (Placement). Those last two models are what let proof compound:
//  without them a candidate is a snapshot, with them a candidate has a history.
// ──────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Auth (Auth.js v5) ─────────────────────────────

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(RECRUITER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // A platform user may *claim* a talent profile (a candidate owning their data).
  claimedProfile   TalentProfile? @relation("ClaimedProfile", fields: [claimedProfileId], references: [id])
  claimedProfileId String?        @unique

  watchlists    Watchlist[]
  savedSearches SavedSearch[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────── Talent domain ────────────────────────────

enum SourceType {
  GITHUB
  GITLAB
  STACKOVERFLOW
  LEETCODE
  LINKEDIN
  X
  WEBSITE
  ONCHAIN
}

enum ProfileStatus {
  DISCOVERED // ingested from public data, unclaimed
  CLAIMED    // the person verified and owns it
  HIDDEN     // removed from the directory (right-to-be-forgotten soft state)
}

model TalentProfile {
  id          String        @id @default(cuid())
  handle      String        @unique // canonical slug, e.g. "torvalds"
  displayName String?
  headline    String?
  bio         String?       @db.Text
  location    String?
  avatarUrl   String?
  websiteUrl  String?
  status      ProfileStatus @default(DISCOVERED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimedBy User? @relation("ClaimedProfile")

  /// Which surface of the trifecta created this card: skill.supply | darktalent | company.university
  origin String?

  connectedAccounts ConnectedAccount[]
  signalSnapshots   SignalSnapshot[]
  scores            Score[]
  repositories      Repository[]
  consents          ConsentRecord[]
  spotlights        Spotlight[]
  watchedBy         WatchlistEntry[]
  tags              ProfileTag[]
  artifacts         Artifact[]
  placements        Placement[]

  // Denormalized latest score, kept in sync on every rescore for fast ranking.
  latestOverall    Float?
  latestConfidence Float?
  latestScoredAt   DateTime?

  @@index([latestOverall])
  @@index([status])
  @@index([location])
  @@index([origin])
}

model ConnectedAccount {
  id        String     @id @default(cuid())
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  source    SourceType
  externalId String?
  username  String
  url       String?

  // OAuth tokens are stored ONLY for CLAIMED profiles that connected the account
  // themselves. DISCOVERED profiles are read via public, unauthenticated APIs.
  accessToken  String? @db.Text
  refreshToken String? @db.Text
  scopes       String?

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([source, username])
  @@index([profileId])
}

/// A point-in-time capture of the normalized `TalentSignals` bundle that feeds
/// the scorer. Snapshots are immutable: re-ingestion creates a new row, giving
/// us an audit trail and the raw material for trajectory analysis over time.
model SignalSnapshot {
  id         String      @id @default(cuid())
  profile    TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  source     SourceType?
  signals    Json        // the full TalentSignals object
  capturedAt DateTime    @default(now())

  scores Score[]

  @@index([profileId, capturedAt])
}

/// A computed DarkTalentScore. We persist the FULL breakdown (pillars, factors,
/// highlights, weights used, model version) so any score can be explained and
/// reproduced, which is essential for fairness and the GDPR right to explanation.
model Score {
  id         String          @id @default(cuid())
  profile    TalentProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  snapshot   SignalSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  snapshotId String?

  overall      Float
  confidence   Float
  breakdown    Json // full DarkTalentScore (pillars + factors + highlights)
  weightsUsed  Json
  modelVersion String
  computedAt   DateTime @default(now())

  @@index([profileId, computedAt])
  @@index([overall])
}

model Repository {
  id          String     @id @default(cuid())
  profile     TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  source      SourceType @default(GITHUB)
  name        String
  url         String
  description String?    @db.Text
  language    String?
  stars       Int        @default(0)
  forks       Int        @default(0)
  isFork      Boolean    @default(false)
  pushedAt    DateTime?

  @@unique([profileId, source, name])
  @@index([profileId])
}

// ──────────────────────────── Consent / privacy (GDPR) ────────────────────────────

enum ConsentScope {
  PUBLIC_INGEST   // ingest public data about me
  PROFILE_DISPLAY // show my profile in the directory
  CONTACT         // allow recruiters to contact me
  ANALYTICS       // include my data in aggregate analytics
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model ConsentRecord {
  id        String        @id @default(cuid())
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  scope     ConsentScope
  status    ConsentStatus @default(GRANTED)
  source    String?       // how consent was captured: oauth | form | import
  ipHash    String?       // hashed for audit, never store a raw IP
  createdAt DateTime      @default(now())

  @@index([profileId, scope])
}

// ──────────────────────────── The write-back: artifacts and outcomes ────────────────────────────

enum ArtifactKind {
  PROJECT   // a shipped thing, the strongest evidence
  REPO      // an original repository
  WRITEUP   // a case study, talk, or piece of writing
  REVIEW    // sustained review or mentorship of others' work
  CREDENTIAL // a completed track, only meaningful when it emits one of the above
}

/// Proof emitted by the academy (company.university) and written back onto the
/// card. This is the step ECOSYSTEM.md calls the flywheel: every attempt
/// manufactures new proof, so a candidate who is not placed this month is
/// measurably more placeable next month. Auto-appliers make noise, this makes
/// signal that compounds to the player.
model Artifact {
  id        String        @id @default(cuid())
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  kind      ArtifactKind
  title     String
  url       String?
  /// Who vouches for it. company.university for academy work, else self-reported.
  issuer    String?
  /// Only true when the issuer verified it. Unverified artifacts never lift a score.
  verified  Boolean       @default(false)
  /// Which card stat this artifact was meant to move: vis|exe|inf|ino|cap|grt
  closesStat String?
  evidence  Json?
  createdAt DateTime      @default(now())

  @@index([profileId, createdAt])
  @@index([verified])
}

enum PlacementOutcome {
  INTRODUCED
  INTERVIEWING
  HIRED
  DECLINED
  LEFT_EARLY // did not survive the guarantee period
  STUCK      // still there past the guarantee period
}

/// The labeled outcome. This is the only thing that can ever validate a score,
/// and it is the asset no competitor has: recruiters hold outcomes without a
/// signal engine, code hosts hold signals without outcomes. Here both sit on
/// the same row.
model Placement {
  id        String           @id @default(cuid())
  profile   TalentProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  company   String
  roleTitle String
  /// The squad slot this seat occupied: VISION|BUILD|INFLUENCE|CAPITAL|GRIT
  slot      String?
  outcome   PlacementOutcome @default(INTRODUCED)

  /// What the engine believed at the moment of introduction. Frozen on purpose:
  /// comparing this against the outcome is how the model gets calibrated.
  predictedFit     Float?
  predictedOverall Float?
  modelVersion     String?

  feeAmount   Int?      // in whole currency units, never a float for money
  feeCurrency String?   @default("USD")
  introducedAt DateTime @default(now())
  startedAt    DateTime?
  endedAt      DateTime?
  notes        String?  @db.Text

  @@index([profileId, introducedAt])
  @@index([outcome])
}

// ──────────────────────────── Curation and recruiter tools ────────────────────────────

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  profiles ProfileTag[]
}

model ProfileTag {
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  tag       Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String

  @@id([profileId, tagId])
}

model Spotlight {
  id        String        @id @default(cuid())
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  title     String
  blurb     String        @db.Text
  featured  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([featured])
}

model Watchlist {
  id        String           @id @default(cuid())
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  name      String
  createdAt DateTime         @default(now())
  entries   WatchlistEntry[]

  @@index([ownerId])
}

model WatchlistEntry {
  watchlist   Watchlist     @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  watchlistId String
  profile     TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  note        String?
  addedAt     DateTime      @default(now())

  @@id([watchlistId, profileId])
  @@index([profileId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  name      String
  query     Json     // filters: languages, min score, custom pillar weights, …
  createdAt DateTime @default(now())

  @@index([ownerId])
}

/// Immutable access log: who viewed/exported/rescored/erased what. Privacy
/// posture is only credible if access is auditable.
model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  action    String   // VIEW_PROFILE | EXPORT | RESCORE | REVOKE_CONSENT | ERASE
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}
