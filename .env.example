# ──────────────────────────────────────────────────────────────
#  darktalent.tech — environment
#  Copy to `.env` and fill in. Never commit `.env`.
# ──────────────────────────────────────────────────────────────

# ---- Database (Neon Postgres) ----
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/darktalent?sslmode=require"
# Direct (non-pooled) connection — used by Prisma Migrate only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/darktalent?sslmode=require"

# ---- Auth.js / NextAuth v5 ----
# Generate a secret: `openssl rand -base64 32`
AUTH_SECRET=""
# GitHub OAuth app: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- Data ingestion ----
# A read-only GitHub PAT (public_repo scope is enough) raises the API rate
# limit for discovery/scoring. Public reads work without it, just slower.
GITHUB_TOKEN=""

# ---- Optional: v2 semantic matching ----
OPENAI_API_KEY=""
